---
/* Marca d'água dos cases e depoimentos não publicados. Só existe em desenvolvimento. */
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="draft" aria-hidden="true">
  <span class="draft__stamp">{text}</span>
  <span class="draft__wash">{text}</span>
</div>

<style>
  .draft {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 2;
  }

  .draft__stamp {
    position: absolute;
    bottom: var(--s-3);
    right: var(--s-3);
    padding: 4px 8px;
    border: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .draft__wash {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-14deg);
    font-family: var(--font-mono);
    font-size: clamp(3rem, 12vw, 9rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.07;
  }
</style>
