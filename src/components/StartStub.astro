---
/*
  Provisório: a folha do formulário chega na Etapa 3.
  O bloco .start__sheet recebe o botão do hero pela View Transition (cta-sheet).
*/
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import { getHome } from '../lib/content';
import { path, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  lead: string;
  note: string;
  back: string;
}

const { lang, title, lead, note, back } = Astro.props;
const home = await getHome(lang);
---

<Base lang={lang} title={`${title} · Hub Performance`} description={lead}>
  <Header lang={lang} nav={home.nav} route="start" />
  <main id="conteudo" class="start">
    <div class="start__sheet">
      <p class="label start__label">{note}</p>
      <h1 class="start__title">{title}</h1>
      <p class="start__lead">{lead}</p>
      <a class="start__back label" href={path('home', lang)}>{back}</a>
    </div>
  </main>
</Base>

<style>
  .start {
    min-height: 100svh;
    padding: calc(var(--nav-h) + var(--s-4)) var(--margin) var(--margin);
    display: flex;
  }

  .start__sheet {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--s-4);
    padding: var(--s-6) var(--s-5);
    background: var(--graphite);
    color: var(--paper);
    view-transition-name: cta-sheet;
  }

  .start__label,
  .start__back {
    color: var(--stone);
  }

  .start__title {
    font-size: var(--text-h2);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    max-width: 16ch;
  }

  .start__lead {
    max-width: var(--measure);
    font-size: var(--text-lead);
    color: var(--stone);
  }

  .start__back {
    margin-top: var(--s-6);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
