---
/*
  F.03 · Projeto de 90 dias.
  Desktop (com movimento): trecho fixo com a cota de 0 a 90 dias; um marcador na cor sinal percorre a cota
  e as fases trocam por máscara. Celular ou movimento reduzido: lista com cota vertical que se preenche.
*/
import Sheet from '../Sheet.astro';
import { fill, type Home, type NumberedSheet } from '../../lib/content';

interface Props {
  content: Home['project'];
  sheet: NumberedSheet;
  prefix: string;
  total: string;
}

const { content, sheet, prefix, total } = Astro.props;
const ticks = [0, 15, 30, 45, 60, 75, 90];
const pct = (d: number) => `${((d / 90) * 100).toFixed(3)}%`;
const pad = (n: number) => String(n).padStart(2, '0');
const phaseData = content.phases.map((p) => ({ from: p.from - 1, to: p.to }));
---

<Sheet id={sheet.id} prefix={prefix} number={sheet.number} total={total} label={sheet.label} title={content.title} lead={content.lead}>
  <div class="tl" data-timeline data-phases={JSON.stringify(phaseData)}>
    <div class="tl__track">
      <div class="tl__stage wrap">
        <div class="tl__top" aria-hidden="true">
          <span class="label">{content.title}</span>
          <span class="label tl__readout"><span data-tl-day>0</span>/90 {content.axis_unit}</span>
        </div>
        <div class="tl__cota" aria-hidden="true">
          <div class="tl__chain">
            {
              content.phases.map((p, i) => (
                <span class="tl__seg" style={`left:${pct(p.from - 1)};width:${pct(p.to - p.from + 1)}`} data-seg={i}>
                  <i>{p.number}</i>
                </span>
              ))
            }
          </div>
          <div class="tl__line">
            <span class="tl__fill" data-tl-fill></span>
            <span class="tl__marker" data-tl-marker></span>
          </div>
          <div class="tl__ticks">
            {
              ticks.map((d) => (
                <span style={`left:${pct(d)}`}>{d}</span>
              ))
            }
            <b>{content.axis_unit}</b>
          </div>
        </div>

        <ol class="tl__phases" data-tl-phases>
          {
            content.phases.map((p, i) => (
              <li class="tl__phase" data-phase={i}>
                <div class="tl__mask">
                  <p class="tl__meta label" data-tl-part>
                    {content.phase_label} {p.number} · {fill(content.days, { from: p.from, to: p.to })}
                  </p>
                </div>
                <div class="tl__mask">
                  <h3 class="tl__name" data-tl-part>{p.name}</h3>
                </div>
                <div class="tl__text">
                  <div class="tl__mask">
                    <p class="tl__body" data-tl-part>{p.body}</p>
                  </div>
                  <div class="tl__mask">
                    <p class="tl__deliv" data-tl-part>
                      <span class="label">{content.deliverable_label}</span>
                      <span>{p.deliverable}</span>
                    </p>
                  </div>
                </div>
              </li>
            ))
          }
          <span class="tl__rail" aria-hidden="true"><span class="tl__rail-fill" data-tl-rail></span></span>
        </ol>
      </div>
    </div>
  </div>

  <div class="specs wrap grid" id="memoria-descritiva">
    <p class="specs__label label" data-reveal="fade">{content.specs.label}</p>
    <h3 class="specs__title" data-reveal="lines">{content.specs.title}</h3>
    <ol class="specs__list">
      {
        content.specs.items.map((item, i) => (
          <li data-reveal-item>
            <span class="specs__n">{pad(i + 1)}</span>
            <span>{item}</span>
          </li>
        ))
      }
    </ol>
  </div>
</Sheet>

<style>
  /* Lista (celular, movimento reduzido, sem JS) */
  .tl__cota {
    display: none;
  }

  .tl__phases {
    position: relative;
    list-style: none;
    padding: 0 0 0 var(--s-7);
    margin: 0;
  }

  .tl__phase {
    position: relative;
    padding: 0 0 var(--s-8);
  }

  .tl__phase::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--s-7));
    top: 0.55em;
    width: 14px;
    height: 1px;
    background: var(--fg);
  }

  .tl__rail {
    position: absolute;
    left: 0;
    top: 0.55em;
    bottom: var(--s-8);
    width: 1px;
    background: var(--rule);
  }

  .tl__rail-fill {
    position: absolute;
    inset: 0;
    background: var(--signal);
    transform-origin: top center;
    transform: scaleY(0);
  }

  :global(html:not(.motion)) .tl__rail-fill {
    transform: none;
  }

  .tl__meta {
    color: var(--fg-muted);
  }

  .tl__name {
    margin-top: var(--s-3);
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-title);
  }

  .tl__body {
    margin-top: var(--s-4);
    max-width: var(--measure);
    color: var(--fg-muted);
  }

  .tl__deliv {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .tl__deliv .label {
    display: block;
    margin-bottom: var(--s-1);
  }

  .tl__top {
    display: none;
  }

  .tl__mask {
    overflow: clip;
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }

  .tl__mask > :global(*) {
    display: block;
  }

  @media (min-width: 768px) {
    .tl__cota {
      display: block;
      position: relative;
      margin: var(--s-2) 0 var(--s-9);
      padding-top: 30px;
    }

    .tl__chain {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      height: 22px;
    }

    .tl__seg {
      position: absolute;
      top: 0;
      height: 22px;
      border-left: 1px solid var(--fg);
      transition: color 0.3s linear;
      color: var(--stone);
    }

    .tl__seg:last-child {
      border-right: 1px solid var(--fg);
    }

    .tl__seg i {
      position: absolute;
      left: 50%;
      top: 0;
      transform: translateX(-50%);
      font-family: var(--font-mono);
      font-size: 0.625rem;
      font-style: normal;
      letter-spacing: 0.06em;
    }

    .tl__seg::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 4px;
      height: 1px;
      background: currentColor;
      opacity: 0.6;
    }

    .tl__seg:global(.is-active) {
      color: var(--fg);
    }

    .tl__line {
      position: relative;
      height: 1px;
      background: var(--fg);
    }

    .tl__fill {
      position: absolute;
      left: 0;
      top: -1px;
      width: 100%;
      height: 3px;
      background: var(--signal);
      transform-origin: left center;
      transform: scaleX(0);
    }

    .tl__marker {
      position: absolute;
      left: 0;
      top: -6px;
      width: 13px;
      height: 13px;
      margin-left: -6px;
      border-radius: 50%;
      background: var(--signal);
      will-change: transform;
    }

    .tl__ticks {
      position: relative;
      height: 28px;
      margin-top: 8px;
      font-family: var(--font-mono);
      font-size: var(--text-label);
      color: var(--fg-muted);
    }

    .tl__ticks span {
      position: absolute;
      top: 0;
      transform: translateX(-50%);
    }

    .tl__ticks span::before {
      content: '';
      position: absolute;
      left: 50%;
      top: -12px;
      width: 1px;
      height: 7px;
      background: var(--fg);
    }

    .tl__ticks b {
      position: absolute;
      right: 0;
      top: 18px;
      font-weight: var(--weight-regular);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
    }

    :global(html:not(.motion)) .tl__marker,
    :global(html:not(.motion)) .tl__fill {
      display: none;
    }

    .tl__phases {
      padding-left: 0;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
    }

    .tl__phase {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: 0;
      padding-bottom: var(--s-8);
    }

    .tl__phase::before,
    .tl__rail {
      display: none;
    }

    .tl__phase > .tl__mask:nth-child(1) {
      grid-column: 1 / 7;
    }

    .tl__phase > .tl__mask:nth-child(2) {
      grid-column: 1 / 7;
    }

    .tl__name {
      font-size: var(--text-h2);
      line-height: var(--leading-display);
      letter-spacing: var(--tracking-display);
    }

    .tl__text {
      grid-column: 7 / 12;
      grid-row: 1 / span 2;
      align-self: end;
    }

    .tl__body {
      margin-top: 0;
      font-size: var(--text-lead);
      line-height: 1.45;
    }

    /* Trecho fixo: só com movimento */
    :global(.motion) .tl__track {
      height: 400svh;
    }

    :global(.motion) .tl__stage {
      position: sticky;
      top: 0;
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-top: calc(var(--nav-h) + var(--s-5));
      padding-bottom: 12svh;
    }

    /* Faixa superior da folha: título e leitura do dia na cota */
    :global(.motion) .tl__top {
      display: flex;
      justify-content: space-between;
      margin-bottom: auto;
      padding-top: var(--s-3);
      border-top: 1px solid var(--rule);
    }

    .tl__readout {
      color: var(--fg);
    }

    :global(.motion) .tl__phase {
      grid-area: 1 / 1 / 2 / -1;
      padding-bottom: 0;
    }

    :global(.motion.js) .tl__phase:not(:global(.is-active)) {
      visibility: hidden;
    }
  }

  /* Memória descritiva */
  .specs {
    margin-top: var(--s-9);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
    row-gap: var(--s-4);
  }

  .specs__label,
  .specs__title,
  .specs__list {
    grid-column: 1 / -1;
  }

  .specs__title {
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-title);
    line-height: 1.1;
  }

  .specs__list {
    list-style: none;
    padding: 0;
    margin-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .specs__list li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: var(--s-3);
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--rule);
    line-height: 1.4;
  }

  .specs__n {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    color: var(--fg-muted);
    padding-top: 0.2em;
  }

  @media (min-width: 768px) {
    .specs {
      margin-top: var(--s-10);
    }

    .specs__label {
      grid-column: 1 / 4;
      padding-top: 0.5em;
    }

    .specs__title {
      grid-column: 4 / 13;
      font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    }

    .specs__list {
      grid-column: 4 / 13;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--gutter);
      border-top: 0;
    }

    .specs__list li {
      border-top: 1px solid var(--rule);
      border-bottom: 0;
    }

    .specs__list li:nth-last-child(-n + 2) {
      border-bottom: 1px solid var(--rule);
    }
  }
</style>
