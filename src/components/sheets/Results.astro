---
/*
  F.04 · Resultados. Fundo grafite. Cada case vem de src/content/cases.
  Números na cor sinal (permitido sobre grafite), contando ao entrar na tela.
  A linha de evolução só aparece se houver série real.
*/
import { Picture } from 'astro:assets';
import Sheet from '../Sheet.astro';
import DraftMark from '../DraftMark.astro';
import { formatCoords, isPlaceholder, type CaseItem, type Home, type NumberedSheet } from '../../lib/content';
import type { Locale } from '../../i18n';

interface Props {
  lang: Locale;
  content: Home['results'];
  watermark: string;
  cases: CaseItem[];
  sheet: NumberedSheet;
  prefix: string;
  total: string;
}

const { lang, content, watermark, cases, sheet, prefix, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const locale = lang === 'en' ? 'en-US' : lang === 'es' ? 'es-ES' : 'pt-PT';
const fmt = (v: number, d: number) => v.toLocaleString(locale, { minimumFractionDigits: d, maximumFractionDigits: d });

function trendPoints(serie: number[]): string {
  const max = Math.max(...serie);
  const min = Math.min(...serie);
  const span = max - min || 1;
  return serie.map((v, i) => `${((i / (serie.length - 1)) * 400).toFixed(1)},${(110 - ((v - min) / span) * 100).toFixed(1)}`).join(' ');
}
---

<Sheet id={sheet.id} prefix={prefix} number={sheet.number} total={total} label={sheet.label} title={content.title} lead={content.lead} dark>
  <div class="results wrap grid">
    <nav class="results__index" aria-label={content.title}>
      <ol>
        {
          cases.map((c, i) => (
            <li>
              <a href={`#case-${c.id}`} data-case-link={c.id}>
                <span class="results__n">{pad(i + 1)}</span>
                <span class="results__city">{c.cidade}</span>
                <span class="results__coords">{formatCoords(c.coordenadas.lat, c.coordenadas.lng)}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="results__cases">
      {
        cases.map((c, i) => (
          <article class="case" id={`case-${c.id}`} data-case={c.id} aria-labelledby={`case-${c.id}-title`}>
            {c.draft && <DraftMark text={watermark} />}
            <header class="case__head">
              <span>
                {content.case_label} {pad(i + 1)}
              </span>
              <span>
                {c.cidade}, {c.pais[lang]}
              </span>
              <span>{formatCoords(c.coordenadas.lat, c.coordenadas.lng)}</span>
            </header>

            <h3 class="case__client" id={`case-${c.id}-title`}>
              {c.cliente[lang]}
            </h3>

            {c.foto && (
              <div class="case__photo" data-reveal="mask">
                <Picture
                  src={c.foto}
                  alt={c.foto_alt?.[lang] ?? ''}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 768px) 60vw, 100vw"
                  formats={['avif', 'webp']}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}

            <div class="case__story">
              <div>
                <p class="label">{content.challenge_label}</p>
                <p>{c.desafio[lang]}</p>
              </div>
              <div>
                <p class="label">{content.done_label}</p>
                <p>{c.feito[lang]}</p>
              </div>
            </div>

            <dl class="case__numbers">
              {c.numeros.map((n) => (
                <div class="case__num">
                  <dt class="case__metric">{n.metrica[lang]}</dt>
                  <dd class="case__value">
                    {typeof n.valor === 'number' ? (
                      <span
                        data-count={n.valor}
                        data-decimals={n.casas}
                        data-prefix={n.prefixo}
                        data-suffix={n.sufixo}
                        data-locale={locale}
                      >
                        {n.prefixo}
                        {fmt(n.valor, n.casas)}
                        {n.sufixo}
                      </span>
                    ) : (
                      <span class:list={{ case__ph: isPlaceholder(n.valor) }}>{n.valor}</span>
                    )}
                  </dd>
                  <dd class="case__src">
                    <span>
                      {content.period_label}: {n.periodo[lang]}
                    </span>
                    <span>
                      {content.source_label}: {n.fonte[lang]}
                    </span>
                  </dd>
                </div>
              ))}
            </dl>

            {c.serie.length > 1 && (
              <figure class="case__trend">
                <svg viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M0 119.5H400" class="case__trend-base" />
                  <polyline points={trendPoints(c.serie)} data-draw />
                </svg>
                <figcaption class="label">{content.evolution_label}</figcaption>
              </figure>
            )}

            {c.frase && <blockquote class="case__quote">“{c.frase[lang]}”</blockquote>}
          </article>
        ))
      }
    </div>
  </div>
</Sheet>

<style>
  .results {
    row-gap: var(--s-7);
  }

  .results__index {
    display: none;
  }

  .results__cases {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  .case {
    position: relative;
    border: 1px solid var(--rule);
    padding: 0 var(--s-4) var(--s-6);
  }

  .case__head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    margin: 0 calc(-1 * var(--s-4));
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .case__client {
    margin-top: var(--s-6);
    font-size: var(--text-h3);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-title);
    line-height: 1.1;
    max-width: 24ch;
  }

  .case__photo {
    margin-top: var(--s-6);
    overflow: clip;
  }

  .case__photo :global(img) {
    width: 100%;
    height: auto;
  }

  .case__story {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
  }

  .case__story p + p {
    margin-top: var(--s-2);
    max-width: var(--measure);
  }

  .case__numbers {
    display: grid;
    gap: var(--s-6);
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }

  .case__num {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .case__value {
    order: -1;
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: var(--weight-regular);
    color: var(--signal);
    font-variant-numeric: tabular-nums;
  }

  .case__ph {
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.02em;
    color: var(--fg-muted);
  }

  .case__metric {
    font-size: var(--text-body);
  }

  .case__src {
    display: flex;
    flex-direction: column;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    color: var(--fg-muted);
  }

  .case__trend {
    margin-top: var(--s-6);
  }

  .case__trend svg {
    width: 100%;
    height: 120px;
    overflow: visible;
  }

  .case__trend polyline {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .case__trend-base {
    stroke: var(--rule);
    vector-effect: non-scaling-stroke;
  }

  .case__quote {
    margin-top: var(--s-6);
    font-size: var(--text-lead);
    max-width: 40ch;
  }

  @media (min-width: 768px) {
    .results__index {
      display: block;
      grid-column: 1 / 4;
    }

    .results__index ol {
      position: sticky;
      top: calc(var(--nav-h) + var(--s-6));
      list-style: none;
      padding: 0;
      border-top: 1px solid var(--rule);
    }

    .results__index a {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      row-gap: 2px;
      padding: var(--s-3) 0;
      border-bottom: 1px solid var(--rule);
      font-family: var(--font-mono);
      font-size: var(--text-label);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--fg-muted);
      transition: color 0.3s linear;
    }

    .results__index a:global(.is-active),
    .results__index a:hover {
      color: var(--fg);
    }

    .results__n {
      grid-row: span 2;
      position: relative;
    }

    .results__index a:global(.is-active) .results__n::after {
      content: '';
      position: absolute;
      left: 0;
      top: 1.6em;
      width: 6px;
      height: 6px;
      background: var(--signal);
    }

    .results__city {
      font-size: 0.8125rem;
      color: var(--fg);
    }

    .results__cases {
      grid-column: 5 / 13;
      gap: var(--s-9);
    }

    .case {
      padding: 0 var(--s-6) var(--s-7);
    }

    .case__head {
      margin: 0 calc(-1 * var(--s-6));
      padding: var(--s-3) var(--s-6);
    }

    .case__story {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--gutter);
    }

    .case__numbers {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: var(--gutter);
    }
  }
</style>
