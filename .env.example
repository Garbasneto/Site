# Copie para .env (local) e configure as mesmas variáveis na Vercel.
# Domínio oficial [confirmar]
PUBLIC_SITE_URL=https://hubperformance.io
# Google Tag Manager [PREENCHER]
PUBLIC_GTM_ID=
# Destino das candidaturas (Make, n8n, Zapier ou CRM) [PREENCHER]
FORM_WEBHOOK_URL=
# Opcional: cria pessoa e negócio no Pipedrive
PIPEDRIVE_API_TOKEN=
# native (formulário do site) ou external (Respondi)
FORM_MODE=native
